# for accessing Domino APIs
export DOMINO_API_HOST=
# Preferred Domino 6.4/7.0+ WebVFS origin; use scheme and host only.
# When unset, as on Domino 6.3.1, WebVFS uses DOMINO_URL.
export DOMINO_WEBVFS_HOST=
# Public Domino deployment origin (scheme, host, optional port), supplied in production.
# Set explicitly for local development or workspaces where it is not supplied.
export DOMINO_URL=
# for auth when running dev mode outside of a Domino App
export DEV_ACCESS_TOKEN=
# for setting the main Flask app's port to not 8888
export MAIN_APP_PORT=
# Domino LLM Gateway for the Chat tab (recommended on Domino). Both are
# required; set neither to fall through to LLM_API_KEY / LLM_BASE_URL.
export DOMINO_LLM_GATEWAY_URL=
export DOMINO_LLM_GATEWAY_MODEL=
# only for running against a Gateway from outside Domino, where the
# localhost:8899 access-token sidecar does not exist
export API_KEY_OVERRIDE=
